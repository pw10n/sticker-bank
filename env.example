# Sticker Bank environment template.
# Copy to a file named .env (gitignored) and replace every placeholder. Never commit real values.

# Backend (Spring Boot binds SPRING_* directly)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/sticker_bank?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
SPRING_DATASOURCE_USERNAME=sticker_bank
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-password
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081
# false only for plain-http localhost development
STICKER_BANK_COOKIE_SECURE=true
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60
APP_VERSION=dev

# compose.yaml (end-to-end stack)
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=sticker_bank
MYSQL_USER=sticker_bank
MYSQL_PASSWORD=replace-with-a-strong-password
APP_HOST_PORT=8080

# Frontend tooling (read by vite.config.ts / Playwright; never exposed to the browser bundle)
API_PROXY_TARGET=http://localhost:8080
E2E_BASE_URL=http://localhost:5173

# Deployment
STICKER_BANK_HOSTNAME=stickers.home.example.com
IMAGE_REGISTRY=registry.example.com/sticker-bank
